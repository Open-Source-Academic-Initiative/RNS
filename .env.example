# RNS Environment Variables Example

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
RNS_VERSION=3.0.0

# Search & Performance
RNS_PAGE_SIZE=100
RNS_MAX_PAGES=100
RNS_SEARCH_LIMIT=10000
RNS_CACHE_TTL_SECONDS=300
RNS_TIMEZONE=America/Bogota

# Storage
# Default points to ./data/rns_snapshots.sqlite3
# RNS_SNAPSHOT_DB_PATH=/path/to/custom/db.sqlite3

# Web UI Defaults
RNS_DEFAULT_MIN_BUDGET=60000000
RNS_DEFAULT_BUDGET=260000000
RNS_WEB_PAGE_SIZE=25
